{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "env": { "builtin": true, "browser": true, "node": true },
  "ignorePatterns": ["**/dist/**", "**/coverage/**", "**/node_modules/**", "apps/api/data/**"],
  "rules": {
    "typescript/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_"
      }
    ],
    "react/set-state-in-effect": "off"
  }
}
